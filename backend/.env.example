# =================================================================
# LLM 可插拔客户端 - 环境变量配置模板
# 用法: cp .env.example .env，按场景改值
# 仓库默认 .env 已内置一份 DeepSeek key 可直接使用
# =================================================================

# ===== 选择 provider =====
# openai / ollama / deepseek / custom
LLM_PROVIDER=deepseek

# ===== Provider URL =====
# OpenAI 官方:    https://api.openai.com/v1
# DeepSeek 官方:  https://api.deepseek.com/v1
# Ollama 本地:    http://localhost:11434/v1
# 任意兼容 API:   填即可
LLM_BASE_URL=https://api.deepseek.com/v1

# ===== API Key =====
# DeepSeek 官方控制台获取；Ollama 可填任意值
LLM_API_KEY=sk-your-deepseek-key

# ===== 模型名 =====
# OpenAI:     gpt-4o, gpt-4o-mini
# DeepSeek:   deepseek-chat, deepseek-reasoner
# Ollama:     qwen2.5:7b, qwen2.5:32b, llama3.1:70b
LLM_MODEL=deepseek-chat

# ===== 协议类型 =====
# chat_completions (默认) / responses / messages
LLM_API_TYPE=chat_completions

# ===== 调优参数（可选） =====
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ===== 额外请求头（可选，JSON 字符串） =====
LLM_EXTRA_HEADERS=

# =================================================================
# 视频文生模型 - 火山方舟 Seedance (Doubao)（可选）
# =================================================================
# local_stub = matplotlib 静态图(免费,演示用) / seedance = 真视频片段
VIDEO_BACKEND=local_stub

SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_API_KEY=
SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
SEEDANCE_RESOLUTION=1080p
SEEDANCE_DURATION_S=10
SEEDANCE_POLL_INTERVAL_S=8
SEEDANCE_POLL_TIMEOUT_S=600

# =================================================================
# 飞书群机器人 webhook（可选）
# 不填则 publisher 步骤静默跳过
# =================================================================
FEISHU_BOT_WEBHOOK=

# =================================================================
# 经营分析陪伴专家 - 擎天平台对接（可选,仅东风内网可用）
# =================================================================
# 这是基于东风集团内部"擎天"企业知识增强平台的对话 Agent,
# base_url 是内网域名,公网环境无法连通。
# 外部用户保持 QINGTIAN_ENABLED=0 即可,前端会显示"专家暂时离线",
# 不影响主流程(5 步 Agent / 简报生成 / VOC 聚类等)。
QINGTIAN_ENABLED=0
QINGTIAN_BASE_URL=https://qingtian.dfmc.com.cn/api/proxy/api/v1
QINGTIAN_API_KEY=
QINGTIAN_USER_ID=analyst-001
QINGTIAN_TIMEOUT=30
