      "name": "销售-售后联动 Agent",
      "uses": ["sales_records", "aftersales_records", "quality_fault_cases"],
      "core": "通过 销售id 跨源关联，识别销售爆款的售后健康度，挖掘高频故障并 RAG 检索根因"
    },
    "market_voc": {
      "name": "市场口碑 Agent ⭐(算法亮点)",
      "uses": ["voc_dongchedi"],
      "core": "竞品 VOC 情感+主题聚类（Sentence-BERT 向量化 + KMeans/HDBSCAN + LLM 主题命名 + 情感强度打分）"
    },
    "composer": {
      "name": "简报合成 Agent",
      "uses": [],
      "core": "汇总上述 2 个 Agent 的结论，模板装配 → Markdown 简报 + 90 秒视频脚本"
    }
  },
